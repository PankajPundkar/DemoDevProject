# Copy this file to .env and adjust values. Never commit your real .env file.

# "development" or "production"
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# REQUIRED in production. Long random string used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Session lifetime in minutes (cookie expiry + server-side session expiry)
SESSION_TTL_MINUTES=120

# Set to "true" when the site is served over HTTPS so cookies get the Secure flag.
# Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false

# Set to "true" when running behind a reverse proxy / load balancer (needed for
# correct client IPs in rate limiting and for Secure cookies behind TLS termination).
TRUST_PROXY=false

# bcrypt cost factor (10-14 is reasonable; higher = slower hashing)
BCRYPT_ROUNDS=12

# Login throttling: max login attempts per IP per window
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Registration throttling: max registration attempts per IP per hour
REGISTER_RATE_LIMIT_MAX=20

# Directory holding the JSON data files (relative to the project root or absolute)
DATA_DIR=data

# Bump this when the cookie policy changes; visitors will be asked for consent again.
COOKIE_POLICY_VERSION=1

# Shown on the Privacy Policy page and footer
SITE_NAME=DemoSite
CONTACT_EMAIL=privacy@example.com

# --- Xray tooling (tools/, MCP server "xray", npm run xray:*) ---
# Xray Cloud API key: Jira > Apps > Xray > API Keys
XRAY_CLIENT_ID=your_xray_client_id
XRAY_CLIENT_SECRET=your_xray_client_secret
XRAY_BASE_URL=https://xray.cloud.getxray.app/api/v2
# Used by `npm run xray:import-results` to publish E2E results as a Test Execution
JIRA_PROJECT_KEY=AQA
# Your Xray Test Plan key, e.g. AQA-57 - set the real value in .env (not committed)
XRAY_TEST_PLAN_KEY=
