<%
  const user = locals.currentUser;
  const navItems = user
    ? [{ href: '/', label: 'Home' }, { href: '/dashboard', label: 'Dashboard' }]
    : [{ href: '/', label: 'Home' }, { href: '/login', label: 'Login' }, { href: '/register', label: 'Register' }];
  const initials = user ? user.fullName.split(/\s+/).filter(Boolean).slice(0, 2).map((p) => p[0].toUpperCase()).join('') : '';
%>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="<%= siteName %> home">
      <img src="/images/logo.svg" alt="" width="32" height="32">
      <span><%= siteName %></span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main navigation">
      <ul class="nav-list">
        <% navItems.forEach((item) => { const active = currentPath === item.href; %>
          <li>
            <a class="nav-link<%= active ? ' is-active' : '' %>" href="<%= item.href %>"<% if (active) { %> aria-current="page"<% } %>><%= item.label %></a>
          </li>
        <% }) %>
      </ul>

      <% if (user) { %>
        <div class="nav-user">
          <span class="user-chip" title="<%= user.email %>">
            <span class="user-chip__avatar" aria-hidden="true"><%= initials %></span>
            <span class="user-chip__text">
              <span class="user-chip__name"><%= user.fullName %></span>
              <span class="user-chip__email"><%= user.email %></span>
            </span>
          </span>
          <form method="post" action="/logout" class="logout-form">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
            <button type="submit" class="btn btn-outline btn-sm">Log out</button>
          </form>
        </div>
      <% } %>
    </nav>
  </div>
</header>
