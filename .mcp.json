{
  "mcpServers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "xray": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/node_modules/tsx/dist/cli.mjs",
        "${CLAUDE_PROJECT_DIR:-.}/tools/xray-mcp/server.ts"
      ],
      "env": {}
    }
  }
}
