{
  "name": "demo-auth-site",
  "version": "1.0.0",
  "private": true,
  "description": "Demo website: Express + TypeScript auth with JSON-file storage and GDPR cookie consent",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/server.js",
    "start:prod": "npm run build && node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "test:e2e": "playwright test --project=chromium --pass-with-no-tests",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:xray": "playwright test --project=xray-tools",
    "typecheck:tools": "tsc -p tools/tsconfig.json",
    "xray:mcp": "tsx tools/xray-mcp/server.ts",
    "xray:import-results": "tsx tools/xray/import-junit-results.ts",
    "xray:verify-auth": "tsx tools/xray/verify-auth.ts",
    "xray:verify-test": "tsx tools/xray/verify-test.ts",
    "xray:verify-parser": "tsx tools/xray/verify-parser.ts",
    "xray:inspect-test-schema": "tsx tools/xray/inspect-expanded-test-schema.ts",
    "xray:inspect-mutation-schema": "tsx tools/xray/inspect-mutation-schema.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "fast-xml-parser": "^5.11.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
